# Copy to .env (git-ignored). Never commit real values: this repository is public.

# --- apps/api ---
PORT=8787
SUPABASE_URL=http://127.0.0.1:54321
# Server-side only. Must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- apps/web (only VITE_* values are exposed to the browser) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8787

# --- supabase tests (plain Postgres 15+ is enough) ---
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_test
