# Copy to apps/api/.env (git-ignored). Never commit real values: this repository is public.
#
# Only the four values in the first block are required. Everything else (public API
# address, email, AI, Slack, UpGuard, review services) can be set by an org admin in
# Admin → Integrations; values set here are only the fallback for organizations that
# have not saved their own.

# --- Required ---
# Origin of the web app; the only one allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key
SUPABASE_PUBLISHABLE_KEY=
# Supabase -> Project Settings -> API Keys -> Secret key (starts with sb_secret_).
# Bypasses Row Level Security. Server-side only: it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption of saved secrets ---
# Secrets saved in Admin → Integrations (API keys, webhook URLs, signing secrets) are
# encrypted with this key. The Node API creates one here on its first start if it is
# empty. Back it up and do not change it: saved secrets can only be read with it.
# On Cloudflare Workers set it as a secret: wrangler secret put INTEGRATION_ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# --- Optional ---
PORT=8787
# Address of Supabase as the browser sees it, when the API reaches Supabase on another address
# (self-host in Docker). Used for file download links. Empty = SUPABASE_URL.
SUPABASE_PUBLIC_URL=
# Allow review services on localhost or private addresses (local testing only).
ALLOW_LOCAL_SERVICE_URLS=

# --- Fallbacks (prefer Admin → Integrations) ---
# Public address of this API, for callback URLs sent to review services.
PUBLIC_API_URL=
# Email for invitations: resend, smtp (Node API only), log (prints to the console), or empty for off.
EMAIL_PROVIDER=
# For example "[Product name] <invites@your-domain.com>"; the domain must be verified with your provider.
EMAIL_FROM=
RESEND_API_KEY=
# For example smtps://user:password@smtp.your-domain.com:465 (URL-encode special characters).
SMTP_URL=
# Optional AI plugin, off by default; the core works without it. Supported: parallel.
AI_PROVIDER=
PARALLEL_API_KEY=
# lite, base (default) or core.
PARALLEL_PROCESSOR=
# UpGuard API base URL (the default is used when empty).
UPGUARD_BASE_URL=
