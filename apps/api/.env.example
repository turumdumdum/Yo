# Copy to apps/api/.env (git-ignored). Never commit real values: this repository is public.

PORT=8787
# Origin of the web app; the only one allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key
SUPABASE_PUBLISHABLE_KEY=
# Supabase -> Project Settings -> API Keys -> Secret key (starts with sb_secret_).
# Bypasses Row Level Security. Server-side only: it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
