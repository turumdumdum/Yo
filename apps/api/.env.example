# Copy to apps/api/.env (git-ignored). Never commit real values: this repository is public.

PORT=8787
# Origin of the web app; the only one allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key
SUPABASE_PUBLISHABLE_KEY=
# Supabase -> Project Settings -> API Keys -> Secret key (starts with sb_secret_).
# Bypasses Row Level Security. Server-side only: it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional AI plugin (off by default; the core works without it) ---
# When enabled, form answers a user asks the AI about are sent to the provider.
# Supported providers: parallel (https://parallel.ai). Leave empty to keep AI off.
AI_PROVIDER=
# Your own Parallel API key. Server-side only.
PARALLEL_API_KEY=
# Processor tier: lite, base (default) or core. Higher tiers are slower and cost more.
PARALLEL_PROCESSOR=

# --- Email (invitations) ---
# Off when empty: the admin then gets each invitation link to share by hand.
# resend: Resend HTTP API (works on Workers and Node). Needs RESEND_API_KEY and EMAIL_FROM.
# smtp:   any SMTP server, Node API only. Needs SMTP_URL and EMAIL_FROM.
# log:    prints emails to the API console instead of sending them (development).
EMAIL_PROVIDER=
# Sender, for example "[Product name] <invites@your-domain.com>". The domain must be
# verified with your email provider.
EMAIL_FROM=
RESEND_API_KEY=
# For example smtps://user:password@smtp.your-domain.com:465 (URL-encode special characters).
SMTP_URL=
