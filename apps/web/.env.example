# Copy to apps/web/.env (git-ignored). Everything here is sent to the browser,
# so only public values belong in this file. Never put the secret key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key (starts with sb_publishable_)
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8787
