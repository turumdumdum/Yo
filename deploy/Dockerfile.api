# API container (Node entrypoint). Build from the repository root:
#   docker build -f deploy/Dockerfile.api .
FROM node:22-alpine
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
# Behind a TLS-inspecting proxy, pass its CA as a build secret named "ca" (optional).
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    pnpm install --frozen-lockfile --filter @app/api...
COPY packages/shared packages/shared
COPY apps/api apps/api
WORKDIR /app/apps/api
USER node
ENV NODE_ENV=production PORT=8787
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1:8787/health || exit 1
CMD ["node_modules/.bin/tsx", "src/node.ts"]
